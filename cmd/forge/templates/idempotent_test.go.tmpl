func TestReplayChecksPermissionBeforeAccessingStore(t *testing.T) {
	h := NewHandler(NewService(&fakeRepo{}))
	// No idempotency store: denied requests must not reach it.
	w := httptest.NewRecorder()
	r := httptest.NewRequest(http.MethodPost, "/v1/{{.Table}}", nil)
	h.createIdempotent(w, r, auth.Principal{Subject: "alice"}, Input{Name: "example"}, []byte(`{"name":"example"}`), "existing-key")
	if w.Code != http.StatusForbidden {
		t.Fatalf("status = %d, want 403", w.Code)
	}
	if w.Header().Get("Idempotency-Replayed") != "" {
		t.Fatal("denied request was replayed")
	}
}

func (f *fakeRepo) CreateIdempotent(_ context.Context, in Input, _ idempotency.Claim) (db.{{.Pascal}}, error) {
	f.createCalled = true
	f.last = db.{{.Pascal}}{ID: uuid.New(), Name: in.Name}
	return f.last, nil
}

func TestServiceCreateIdempotentRequiresPermission(t *testing.T) {
	repo := &fakeRepo{}
	svc := NewService(repo)
	_, err := svc.CreateIdempotent(context.Background(), auth.Principal{}, Input{Name: "example"}, idempotency.Claim{Key: "k"})
	if !errors.Is(err, ErrForbidden) {
		t.Fatalf("got %v, want ErrForbidden", err)
	}
	if repo.createCalled {
		t.Error("repository CreateIdempotent should not run without permission")
	}
}
