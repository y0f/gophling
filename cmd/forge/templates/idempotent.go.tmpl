package {{.Snake}}

import (
	"context"
	"errors"
	"fmt"
	"net/http"

	"github.com/jackc/pgx/v5"

	"{{.Module}}/internal/auth"
	db "{{.Module}}/internal/gen/db"
	"{{.Module}}/internal/idempotency"
	"{{.Module}}/internal/platform/database"
)

// EnableIdempotency makes create honour the Idempotency-Key header.
func (h *Handler) EnableIdempotency(store *idempotency.Store) {
	h.idempotency = store
}

// createIdempotent serves a create that carries an Idempotency-Key: replay the
// stored response if there is one, otherwise create and store the response in
// the same transaction. Replay sets Location from the response's JSON "id".
func (h *Handler) createIdempotent(w http.ResponseWriter, r *http.Request, actor auth.Principal, in Input, body []byte, key string) {
	// A retry must satisfy today's policy, even when its response is cached.
	if err := h.service.authorizeWrite(actor); err != nil {
		h.writeError(w, r, err)
		return
	}
	claim, ok := h.idempotency.NewClaim(w, r, actor.Subject, key, body)
	if !ok || h.idempotency.Replay(w, r, claim, "/v1/{{.Table}}/") {
		return
	}
	created, err := h.service.CreateIdempotent(r.Context(), actor, in, claim)
	if errors.Is(err, idempotency.ErrReserved) && h.idempotency.Replay(w, r, claim, "/v1/{{.Table}}/") {
		return // A concurrent request claimed the key first.
	}
	if err != nil {
		h.writeError(w, r, err)
		return
	}
	writeCreated(w, created)
}

func (s *Service) CreateIdempotent(ctx context.Context, actor auth.Principal, in Input, claim idempotency.Claim) (db.{{.Pascal}}, error) {
	if err := s.authorizeWrite(actor); err != nil {
		return db.{{.Pascal}}{}, err
	}
	if err := in.Validate(); err != nil {
		return db.{{.Pascal}}{}, err
	}
	return s.repo.CreateIdempotent(ctx, in, claim)
}

// CreateIdempotent persists the {{.Snake}} and its idempotency key in one
// transaction. If a concurrent request already holds the key the create is
// rolled back and idempotency.ErrReserved is returned, so the caller replays
// the stored response instead of creating a duplicate.
func (r *pgRepository) CreateIdempotent(ctx context.Context, in Input, claim idempotency.Claim) (db.{{.Pascal}}, error) {
	var created db.{{.Pascal}}
	err := database.WithinTx(ctx, r.pool, func(tx pgx.Tx) error {
		var txErr error
		if created, txErr = r.insert(ctx, tx, in); txErr != nil {
			return txErr
		}
		return idempotency.Put(ctx, tx, claim, http.StatusCreated, toResponse(created))
	})
	switch {
	case errors.Is(err, idempotency.ErrReserved):
		return db.{{.Pascal}}{}, idempotency.ErrReserved
	case err != nil:
		return db.{{.Pascal}}{}, fmt.Errorf("create {{.Snake}}: %w", err)
	}
	return created, nil
}
